@page "/dashboard"
@model CallTarifier.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Summary;
    var cards = new[]
    {
        new StatCardModel { Title = "Consumo acumulado", Value = DisplayHelpers.FormatMoney(s.MonthSubtotal), Hint = "Mes en curso, sin IVA" },
        new StatCardModel { Title = "IVA 15%", Value = DisplayHelpers.FormatMoney(s.MonthTax), Hint = "Sobre el consumo del mes" },
        new StatCardModel { Title = "Total con IVA", Value = DisplayHelpers.FormatMoney(s.AccumulatedCost), Hint = s.ShowsAllExtensions ? "Cobro del E1 BAC 1000" : "Tu extensión" },
        new StatCardModel { Title = "Días para el cierre", Value = s.DaysUntilBilling.ToString(), Hint = "Facturación al final del mes" },
        new StatCardModel { Title = "Llamadas del mes", Value = s.MonthCalls.ToString(), Hint = "Registradas en el periodo" }
    };
}

<section class="page-header">
    <div>
        <h1>Hola, @s.UserName.Split(' ').FirstOrDefault()</h1>
        <p class="page-subtitle">
            E1 BAC <strong class="mono">1000</strong>
            @if (!string.IsNullOrWhiteSpace(s.Extension))
            {
                <text> · Tu extensión <strong class="mono">@s.Extension</strong> @s.Branch</text>
            }
        </p>
    </div>
    <a class="btn btn-primary" asp-page="/Calls/Dial">Nueva llamada</a>
</section>

<section class="stat-grid">
    @foreach (var card in cards)
    {
        <partial name="Partials/_StatCard" model="card" />
    }
</section>

<section class="panel">
    <div class="panel-header">
        <h2>@(s.ShowsAllExtensions ? "Consumo de todas las extensiones" : "Consumo de tu extensión")</h2>
        <span class="page-subtitle">@s.PendingInvoices facturas pendientes</span>
    </div>
    @if (s.ByExtension.Count == 0)
    {
        <p class="call-note">Todavía no hay consumo registrado en este mes.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Extensión</th>
                        <th>Nombre</th>
                        <th class="num">Llamadas</th>
                        <th class="num">Consumo</th>
                        <th class="num">IVA</th>
                        <th class="num">Total</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in s.ByExtension)
                {
                    <tr>
                        <td class="mono">@row.Extension</td>
                        <td>@row.Name</td>
                        <td class="num">@row.Calls</td>
                        <td class="num">@DisplayHelpers.FormatMoney(row.Subtotal)</td>
                        <td class="num">@DisplayHelpers.FormatMoney(row.Tax)</td>
                        <td class="num">@DisplayHelpers.FormatMoney(row.Total)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-header">
        <h2>Llamadas recientes</h2>
        <a class="link" asp-page="/Calls/Index">Ver historial</a>
    </div>
    <partial name="Partials/_CallTable" model="s.RecentCalls" />
</section>
