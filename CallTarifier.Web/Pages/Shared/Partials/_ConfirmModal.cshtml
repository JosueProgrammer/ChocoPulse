<div class="modal" id="confirm-modal" hidden role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <div class="modal-card">
        <h2 id="confirm-title">Confirmar</h2>
        <p id="confirm-message">¿Desea continuar?</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" id="confirm-cancel">Cancelar</button>
            <button type="button" class="btn btn-primary" id="confirm-ok">Confirmar</button>
        </div>
    </div>
</div>
