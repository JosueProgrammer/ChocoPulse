@page "/settings"
@model CallTarifier.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Configuración";
    var webrtcReady = !string.IsNullOrWhiteSpace(Model.WebRtc.WebSocketUrl);
}

<section class="page-header">
    <div>
        <h1>Configuración</h1>
        <p class="page-subtitle">Preferencias visibles. Los secretos AMI no se exponen aquí.</p>
    </div>
</section>

<section class="settings-grid">
    <article class="panel">
        <h2>Telefonía</h2>
        <dl class="detail-list">
            <div><dt>Servidor SIP/WebRTC</dt><dd>@(string.IsNullOrWhiteSpace(Model.WebRtc.SipServer) ? "Pendiente WSS" : Model.WebRtc.SipServer)</dd></div>
            <div><dt>Dominio SIP</dt><dd>@(string.IsNullOrWhiteSpace(Model.WebRtc.SipDomain) ? "—" : Model.WebRtc.SipDomain)</dd></div>
            <div><dt>WebSocket</dt><dd>@(webrtcReady ? Model.WebRtc.WebSocketUrl : "No configurado")</dd></div>
            <div><dt>Extensión</dt><dd class="mono">@Model.CurrentUser?.Extension</dd></div>
            <div><dt>Estado de conexión</dt><dd><span class="badge badge-neutral" id="settings-phone-state">Desconectado</span></dd></div>
        </dl>
    </article>

    <article class="panel">
        <h2>Tarifas</h2>
        <dl class="detail-list">
            <div><dt>Local</dt><dd>Sin cobro hasta @Model.Tariffs.LocalFreeMinutes min, luego @DisplayHelpers.FormatMoney(Model.Tariffs.LocalAfterQuota)</dd></div>
            <div><dt>Interlocal, por minuto</dt><dd>@DisplayHelpers.FormatMoney(Model.Tariffs.InterlocalPerMinute)</dd></div>
            <div><dt>Entre E1, por minuto</dt><dd>@DisplayHelpers.FormatMoney(Model.Tariffs.EntreE1PerMinute)</dd></div>
            <div><dt>Claro, por minuto</dt><dd>@DisplayHelpers.FormatMoney(Model.Tariffs.ClaroPerMinute)</dd></div>
            <div><dt>Tigo, por minuto</dt><dd>@DisplayHelpers.FormatMoney(Model.Tariffs.TigoPerMinute)</dd></div>
            <div><dt>Internacional, por minuto</dt><dd>@DisplayHelpers.FormatMoney(Model.Tariffs.InternacionalPerMinute)</dd></div>
            <div><dt>Mínimo contestada</dt><dd>@DisplayHelpers.FormatMoney(Model.Tariffs.MinimumAnswered)</dd></div>
            <div><dt>Intento no contestado</dt><dd>@DisplayHelpers.FormatMoney(Model.Tariffs.UnansweredAttempt)</dd></div>
            <div><dt>IVA</dt><dd>@((Model.Tariffs.TaxRate * 100).ToString("0"))%</dd></div>
        </dl>
    </article>

    <article class="panel">
        <h2>Usuario</h2>
        <dl class="detail-list">
            <div><dt>Nombre</dt><dd>@Model.CurrentUser?.Name</dd></div>
            <div><dt>Correo</dt><dd>@Model.CurrentUser?.Email</dd></div>
            <div><dt>Extensión</dt><dd class="mono">@Model.CurrentUser?.Extension</dd></div>
            <div><dt>Nombre</dt><dd>@Model.CurrentUser?.Branch</dd></div>
            <div><dt>Rol</dt><dd>@Model.CurrentUser?.Role</dd></div>
        </dl>
    </article>

    <article class="panel">
        <h2>Aplicación</h2>
        <dl class="detail-list">
            <div><dt>Modo datos</dt><dd>Firestore (producción)</dd></div>
            <div><dt>Firebase Auth</dt><dd>Activo</dd></div>
            <div><dt>AMI</dt><dd>Gestionado por CallTarifier.Integration</dd></div>
        </dl>
    </article>
</section>
