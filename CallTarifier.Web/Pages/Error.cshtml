@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    ViewData["IsLoginPage"] = true;
}

<section class="login-page">
    <div class="login-panel">
        <h1>Ha ocurrido un error</h1>
        <p>No se pudo completar la solicitud. Intente nuevamente.</p>
        @if (Model.ShowRequestId)
        {
            <p class="call-note">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary btn-block" href="/dashboard">Ir al dashboard</a>
    </div>
</section>
